      "name": "Get Users List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{reqres_base_url}}/users",
          "host": [
            "{{reqres_base_url}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Single User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Single user fetched', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let jsonData = pm.response.json();",
              "",
              "pm.test('User email exists', function () {",
              "    pm.expect(jsonData.data.email).to.exist;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{reqres_base_url}}/users/2",
          "host": [
            "{{reqres_base_url}}"
          ],
          "path": [
            "users",
            "2"
          ]
        }
      },
      "response": []
    }
  ],
